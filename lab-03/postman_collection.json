          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "S8 Create book",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Test Book\",\n  \"author\": \"Tester\",\n  \"price\": 199.5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"createdBookId\", pm.response.json().book.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "S9 Update book (change id to the new one)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books/{{createdBookId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "{{createdBookId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Test Book v2\",\n  \"author\": \"Tester\",\n  \"price\": 249\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "S10 Delete book (change id to the new one)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/{{createdBookId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "{{createdBookId}}"
